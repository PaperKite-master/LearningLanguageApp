NODE_ENV=development
PORT=4000

# Supabase Auth
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# CORS — origin FE (Vercel), phân tách bằng dấu phẩy, không / ở cuối
CORS_ORIGIN="http://localhost:3000,https://hina-japanese-app.vercel.app"

# For local docker postgres (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_language_app?schema=public"

# Optional (if you later connect to Supabase hosted Postgres)
# Supabase recommended setup with Prisma:
# - DATABASE_URL: pooler/transaction URL for runtime
# - DIRECT_URL: direct connection for migrations
#
# Example using Transaction pooler (IPv4, port 6543) - add pgbouncer=true:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
#
# Example direct connection (port 5432):
# DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Optional: Gemini for subtitle translation (falls back to Google Translate free endpoint)
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-2.0-flash"

# --- Email OTP ---
# Render FREE chặn SMTP (cổng 25/465/587). Production nên dùng Resend (HTTPS):
# 1. Đăng ký https://resend.com → API Keys → tạo key
# 2. Thêm RESEND_API_KEY trên Render → Redeploy
# 3. (Tuỳ chọn) Verify domain rồi set RESEND_FROM=noreply@yourdomain.com
#    Không có domain: dùng onboarding@resend.dev (chỉ gửi được tới email tài khoản Resend khi test)
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# SMTP Gmail — chỉ dùng local / Render paid (App Password, không dùng mật khẩu Gmail thường)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="your-email@gmail.com"
SMTP_FROM_NAME="HiNa Japanese Learning"
